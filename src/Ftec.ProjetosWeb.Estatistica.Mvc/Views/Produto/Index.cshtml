@model List<ProdutoItemViewModel>
@{
    ViewData["Title"] = "Produtos";
    var searchTerm = ViewBag.SearchTerm as string;
}

<h1 class="mb-4">Catalogo de Produtos</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <form asp-action="Search" asp-controller="Produto" method="get" class="d-flex">
            <input type="text" name="q" class="form-control me-2" placeholder="Buscar produtos..." value="@searchTerm" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(searchTerm))
{
    <p class="text-muted">Resultados para: <strong>@searchTerm</strong></p>
}

@if (Model.Any())
{
    <div class="row">
        @foreach (var produto in Model)
        {
            <div class="col-md-4 col-lg-3 mb-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@produto.Nome</h5>
                        <p class="card-text text-muted small">@produto.Codigo</p>
                        @if (!string.IsNullOrEmpty(produto.Descricao))
                        {
                            <p class="card-text small flex-grow-1">@produto.Descricao</p>
                        }
                        else
                        {
                            <div class="flex-grow-1"></div>
                        }
                        <h4 class="text-primary">@produto.Preco.ToString("C")</h4>
                        <a asp-action="Details" asp-route-id="@produto.Id" class="btn btn-outline-primary mt-2">Ver detalhes</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning">Nenhum produto encontrado.</div>
}
