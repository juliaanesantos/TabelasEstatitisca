@model List<PedidoResumoViewModel>
@{
    ViewData["Title"] = "Pedidos";
}

<h1 class="mb-4">Pedidos Realizados</h1>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Data</th>
                    <th>Status</th>
                    <th>Valor Total</th>
                    <th>Itens</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pedido in Model)
                {
                    <tr>
                        <td>@pedido.CodigoPedido</td>
                        <td>@pedido.NomeCliente</td>
                        <td>@pedido.DataPedido.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            @switch (pedido.StatusPedido)
                            {
                                case 0: <span class="badge bg-secondary">Pendente</span>; break;
                                case 1: <span class="badge bg-warning text-dark">Processando</span>; break;
                                case 2: <span class="badge bg-success">Finalizado</span>; break;
                                case 3: <span class="badge bg-danger">Cancelado</span>; break;
                                default: <span class="badge bg-secondary">@pedido.StatusPedido</span>; break;
                            }
                        </td>
                        <td>@pedido.ValorTotal.ToString("C")</td>
                        <td>
                            @if (pedido.ProdutosModel != null && pedido.ProdutosModel.Any())
                            {
                                <ul class="list-unstyled mb-0">
                                    @foreach (var item in pedido.ProdutosModel)
                                    {
                                        <li><small>@item.NomeProduto x @item.Quantidade</small></li>
                                    }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">Nenhum pedido encontrado.</div>
}
