@model List<MediaVendasClientesViewModel>
@{
    ViewData["Title"] = "Media de Vendas por Cliente";
}

<h1 class="mb-4">Media de Vendas por Cliente</h1>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Cliente</th>
                    <th>Qtd Pedidos</th>
                    <th>Total Vendas</th>
                    <th>Media por Pedido</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NomeCliente</td>
                        <td>@item.QuantidadePedidos</td>
                        <td>@item.TotalVendas.ToString("C")</td>
                        <td>@item.MediaVendas.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">Nenhum dado disponivel.</div>
}
