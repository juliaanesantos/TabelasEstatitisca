@model List<MediaVendaPorProdutoViewModel>
@{
    ViewData["Title"] = "Media de Venda por Produto";
}

<h1 class="mb-4">Media de Venda por Produto</h1>

@if (Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Produto</th>
                    <th>Qtd Vendida</th>
                    <th>Valor Total</th>
                    <th>Media por Venda</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NomeProduto</td>
                        <td>@item.QuantidadeVendida</td>
                        <td>@item.ValorTotal.ToString("C")</td>
                        <td>@item.MediaVenda.ToString("C")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">Nenhum dado disponivel.</div>
}
