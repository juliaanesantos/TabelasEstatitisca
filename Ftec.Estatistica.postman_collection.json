{
  "info": {
    "name": "Ftec.Estatistica",
    "description": "Collection completa de testes da API de Estatisticas com integracao aos microsservicos do Marketplace",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5168", "type": "string" },
    { "key": "usuarioUrl", "value": "http://usuario.neurosky.com.br", "type": "string" },
    { "key": "produtoUrl", "value": "http://produto.neurosky.com.br", "type": "string" },
    { "key": "pedidoUrl", "value": "http://pedido.neurosky.com.br", "type": "string" },
    { "key": "avaliacaoUrl", "value": "http://avaliacao.neurosky.com.br", "type": "string" },
    { "key": "email", "value": "estatistica@neurosky.com.br", "type": "string" },
    { "key": "senha", "value": "Estatistica@123", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "usuarioId", "value": "", "type": "string" },
    { "key": "produtoId", "value": "", "type": "string" },
    { "key": "avaliacaoId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth / Usuario",
      "item": [
        {
          "name": "Login (salva token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login realizado com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('token', json.accessToken);",
                  "    pm.collectionVariables.set('usuarioId', json.usuarioId);",
                  "    pm.expect(json.accessToken).to.not.be.empty;",
                  "    pm.expect(json.usuarioId).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"senha\": \"{{senha}}\"\n}"
            },
            "url": {
              "raw": "{{usuarioUrl}}/api/autenticacao/login",
              "host": ["{{usuarioUrl}}"],
              "path": ["api", "autenticacao", "login"]
            }
          }
        },
        {
          "name": "Cadastrar Usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario criado com sucesso', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('usuarioId', json.id || json.usuarioId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Usuario Teste\",\n  \"email\": \"teste@email.com\",\n  \"senha\": \"Teste@123\",\n  \"documento\": \"01234567890\",\n  \"tipoPessoa\": 0,\n  \"funcao\": 0,\n  \"dataNascimento\": \"2000-01-01\",\n  \"telefone\": \"54999999999\"\n}"
            },
            "url": {
              "raw": "{{usuarioUrl}}/api/usuario",
              "host": ["{{usuarioUrl}}"],
              "path": ["api", "usuario"]
            }
          }
        },
        {
          "name": "Obter Usuario por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario obtido com sucesso', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.nome).to.not.be.empty;",
                  "    pm.expect(json.email).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{usuarioUrl}}/api/usuario/{{usuarioId}}",
              "host": ["{{usuarioUrl}}"],
              "path": ["api", "usuario", "{{usuarioId}}"]
            }
          }
        }
      ]
    },
